<%- include('partials/cabecera') %>
    <h1>Horario de la biblioteca</h1>
    <p>Estos son los días y horas en los que puedes visitarnos:</p>
    <table>
      <thead>
        <tr><th>Día</th><th>Horas</th></tr>
      </thead>
      <tbody>
        <% horario.forEach(fila => { %>
          <tr>
            <td><%= fila.dia %></td>
            <td><%= fila.horas %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
<%- include('partials/pie') %>
