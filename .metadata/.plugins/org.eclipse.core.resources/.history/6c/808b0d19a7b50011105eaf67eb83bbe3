package repasojava.model;

import java.time.LocalDate;

import repasojava.exceptions.CraftersExceptions;

public class EventoDeportivo extends Evento{
	private Boolean esTelevisado;
	private int precio;
	

	public EventoDeportivo(String nombre, LocalDate fecha, int entradasVendidas, int capacidadMaxima,
			estadoEvento estado, Boolean esTelevisado) throws CraftersExceptions {
		super(nombre, fecha, entradasVendidas, capacidadMaxima, estado, Boolean esTelevisado);
		this.esTelevisado = esTelevisado;
		if ( getCapacidadMaxima() > 3000 ) {
			this.precio = 150000;
		}
		else {this.precio = 75000 ;}
	}



	@Override
	public double calcularCosteBase() {
		double coste = 0;
		if (esTelevisado) {
			 coste = precio - 10000;
		}else {coste = precio;}
		
		return 0;
	}



	public Boolean getEsTelevisado() {
		return esTelevisado;
	}



	public void setEsTelevisado(Boolean esTelevisado) {
		this.esTelevisado = esTelevisado;
	}



	public int getPrecio() {
		return precio;
	}



	public void setPrecio(int precio) {
		this.precio = precio;
	}



	@Override
	public String toString() {
		return "EventoDeportivo [esTelevisado=" + esTelevisado + ", precio=" + precio + "]";
	}
	
	

}
