package  repasojava.ejercicio1.model;

import java.time.LocalDate;
import java.util.Arrays;
import java.util.List;

import repasojava.exceptions.CraftersExceptions;

public class Concierto extends Evento {
	
	private String artistaPrincipal;
	private String[] invitados;
	private int numInvitados;
	
	
	public Concierto(String nombre, LocalDate fecha, int entradasVendidas, int capacidadMaxima, estadoEvento estado, String artistaPrincipal)
			throws CraftersExceptions {
		super(nombre, fecha, entradasVendidas, capacidadMaxima, estado);
		numInvitados = 0;
		this.artistaPrincipal = artistaPrincipal;
		invitados= new String[10];
		numInvitados++;
	}
	
	public String getArtistaPrincipal() {
		return artistaPrincipal;
	}


	public void setArtistaPrincipal(String artistaPrincipal) {
		this.artistaPrincipal = artistaPrincipal;
	}


	public String[] getInvitados() {
		return invitados;
	}


	public void setInvitados(String[] invitados) {
		this.invitados = invitados;
	}


	@Override
	public double calcularCosteBase() {
		int costeTotalInvitados = numInvitados * 500;
		int coste = 5000 + 2000 + costeTotalInvitados;
		return coste;
	}
	
	public void agregarInvitado(String nombre) {
		invitados[numInvitados] = nombre;
	}

	@Override
	public String toString() {
		return "Concierto [artistaPrincipal=" + artistaPrincipal + ", invitados=" + Arrays.toString(invitados)
				+ ", numInvitados=" + numInvitados + "]";
	}
	
	
	
	

}
