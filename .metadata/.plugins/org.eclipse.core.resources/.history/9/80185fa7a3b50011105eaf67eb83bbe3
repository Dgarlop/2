package repasojava.model;

import java.util.List;

public class Concierto extends Evento {
	
	private String artistaPrincipal;
	private String[] invitados;
	private int numInvitados;
	public Concierto(String artistaPrincipal) {
		super(nombre, fecha, capacidadMaxima, entradasVendidas, estado);
		numInvitados = 0;
		this.artistaPrincipal = artistaPrincipal;
		invitados= new String[10];
		numInvitados++;
	}
	
	
	public String getArtistaPrincipal() {
		return artistaPrincipal;
	}


	public void setArtistaPrincipal(String artistaPrincipal) {
		this.artistaPrincipal = artistaPrincipal;
	}


	public String[] getInvitados() {
		return invitados;
	}


	public void setInvitados(String[] invitados) {
		this.invitados = invitados;
	}


	@Override
	public double calcularCosteBase() {
		int costeTotalInvitados = numInvitados * 500;
		int coste = 5000 + 2000 + costeTotalInvitados;
		return coste;
	}
	
	public void agregarInvitado(String nombre) {
		invitados[numInvitados] = nombre;
	}
	
	
	

}
